
{
  "expo": {
    "name": "UberClone Conductor",
    "slug": "uberclone-conductor",
    "version": "1.0.0",
    "scheme": "uberclone-conductor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",

    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrarte en el mapa y recibir solicitudes mientras estás disponible."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecciona las fotos de perfil, vehículo y documentos para el registro.",
          "cameraPermission": "Toma las fotos necesarias para el registro del conductor."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "ios": {
      "bundleIdentifier": "com.jesid.uberclon",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },

    "android": {
      "package": "com.jesid.uberclon",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9676e5b7-b5ed-4724-b2fa-673dab2e5dea"
      }
    }
  }
}
